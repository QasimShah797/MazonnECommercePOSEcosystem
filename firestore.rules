rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() {
      return signedIn() && userDoc().role == 'admin';
    }
    function vendorDoc() {
      return get(/databases/$(database)/documents/vendors/$(request.auth.uid)).data;
    }
    function vendorApproved() {
      return exists(/databases/$(database)/documents/vendors/$(request.auth.uid))
        && vendorDoc().approvalStatus == 'approved';
    }
    function vendorSelfUpdateAllowed() {
      return resource.data.approvalStatus == request.resource.data.approvalStatus
        || (resource.data.approvalStatus == 'rejected'
            && request.resource.data.approvalStatus == 'pending');
    }
    function marketplaceVisible() {
      return resource.data.moderation == 'approved'
        && resource.data.get('vendorApprovalStatus', 'approved') == 'approved';
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if isAdmin() || isOwner(vendorId);
      allow create: if isOwner(vendorId)
        && request.resource.data.approvalStatus == 'pending';
      allow update: if isAdmin() || (isOwner(vendorId) && vendorSelfUpdateAllowed());
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if marketplaceVisible() ||
        (signedIn() && resource.data.vendorId == request.auth.uid) ||
        isAdmin();
      allow create: if isAdmin() || (
        signedIn()
        && request.resource.data.vendorId == request.auth.uid
        && vendorApproved()
        && request.resource.data.vendorApprovalStatus == 'approved'
        && request.resource.data.moderation in ['draft', 'pending']
      );
      allow update: if isAdmin() || (
        signedIn()
        && resource.data.vendorId == request.auth.uid
        && vendorApproved()
        && request.resource.data.vendorId == resource.data.vendorId
        && request.resource.data.vendorApprovalStatus == 'approved'
        && request.resource.data.moderation in ['draft', 'pending', 'rejected']
      );
      allow delete: if (signedIn() && resource.data.vendorId == request.auth.uid && vendorApproved()) || isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        resource.data.vendorId == request.auth.uid ||
        isAdmin()
      );
      allow update: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        isAdmin() ||
        (resource.data.vendorId == request.auth.uid && vendorApproved())
      );
    }

    match /notifications/{id} {
      allow read: if signedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if signedIn();
      allow update: if signedIn() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    match /deviceTokens/{token} {
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    match /supportRequests/{id} {
      allow create: if signedIn() && request.resource.data.vendorId == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow update: if isAdmin();
    }

    match /meta/{id} {
      allow read, write: if signedIn();
    }

    match /subscriptionPlans/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /vendorSubscriptions/{id} {
      allow read: if isAdmin() || isOwner(id);
      allow write: if isAdmin();
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /searchConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vendorKyc/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.vendorId == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.vendorId == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && resource.data.vendorId == request.auth.uid);
    }
  }
}
